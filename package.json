{
  "name": "bundil",
  "version": "0.1.0",
  "type": "module",
  "description": "Pack ESM libraries for npm with Bun and Rolldown.",
  "funding": "https://github.com/sponsors/Jaid",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaid/bundil.git"
  },
  "exports": {
    ".": {
      "default": "./src/main.ts"
    }
  },
  "bin": "./src/cli.ts",
  "imports": {
    "#src/*": "./src/*",
    "#root/*": "./*"
  },
  "scripts": {
    "build": "bun src/cli.ts",
    "test": "bun test --max-concurrency 1 ./test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fs-extra": "11.4.1",
    "rolldown": "1.3.3",
    "rolldown-plugin-dts": "0.30.2",
    "semver": "7.8.6",
    "terser": "5.51.4",
    "typescript": "npm:typescript-classic@6.0.4"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "eslint-config-jaid": "35.0.0",
    "tsconfig-jaid-bun": "16.0.0",
    "@types/bun": "1.4.3",
    "@types/fs-extra": "11.0.4",
    "@types/semver": "7.8.0"
  }
}
